---
// Homepage (DESIGN-SPEC.md 8): hero with a labelled example cluster, Sources and Methods strip, the three Version 1 calculators,
// and the three latest published Journal articles (generated from the content collection; the section is omitted when there are none).
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ResultRing from '../components/ResultRing.astro';
import CalculatorCard from '../components/CalculatorCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { calculators } from '../config/site';
import { getPublishedArticles } from '../lib/journal';
import { evaluateBmi } from '../calculators/bmi';
import { evaluateEnergy } from '../calculators/bmr-tdee';
import { evaluateBodyFat } from '../calculators/body-fat';
import '../styles/pages.css';

// The hero's example numbers are produced by the real calculators from one stated example (DESIGN-SPEC.md 8, D-HERO),
// so they can never drift from the calculators. The build fails if the example stops being valid.
const example = { age: '28', height: '178', weight: '74', neck: '38', waist: '84' };
const bmi = evaluateBmi({ sex: 'male', age: example.age, height: example.height, weight: example.weight });
const energy = evaluateEnergy({ sex: 'male', age: example.age, height: example.height, weight: example.weight, activity: 'lowActive' });
const fat = evaluateBodyFat({ sex: 'male', height: example.height, neck: example.neck, waist: example.waist, hip: '', weight: '' });
if (bmi.status !== 'ok' || energy.status !== 'ok' || fat.status !== 'ok') throw new Error('The homepage example is no longer valid for the calculators.');

// Sources actually used by the three calculators (CALCULATION-SPEC.md 0.4).
const sources = [
  { label: 'CDC adult BMI categories', href: 'https://www.cdc.gov/bmi/adult-calculator/bmi-categories.html' },
  { label: 'WHO obesity and overweight', href: 'https://www.who.int/news-room/fact-sheets/detail/obesity-and-overweight' },
  { label: 'National Academies: Dietary Reference Intakes for Energy', href: 'https://www.nationalacademies.org/read/26818/chapter/2' },
  { label: 'Mifflin–St Jeor equations (1990)', href: 'https://pubmed.ncbi.nlm.nih.gov/2305711/' },
  { label: 'US Navy body composition guide (2016)', href: 'https://dcp.psc.gov/ccmis/pdf_docs/Body%20Composition%20Assessment%20(BCA)%202016.pdf' },
];

const latest = (await getPublishedArticles()).slice(0, 3);
---
<BaseLayout title="Home" description="Free BMI, energy expenditure (BMR and TDEE) and body fat calculators with formulas and sources shown. Runs in your browser.">
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <span class="kicker">Evidence-Informed Health Intelligence</span>
      <h1 id="hero-heading">Understand your body. <span class="hero-accent">Make informed choices.</span></h1>
      <p>Explore free, evidence-informed health calculators designed to help you understand your numbers with clear explanations and no sign-up required.</p>
      <a class="button primary" href="#calculators"><span>Explore Calculators</span><Icon name="arrow-right" size={18} /></a>
      <ul class="reassure">
        <li><Icon name="check" size={18} /> 100% Free</li>
        <li><Icon name="check" size={18} /> No Registration</li>
        <li><Icon name="check" size={18} /> Private &amp; Client-Side</li>
      </ul>
    </div>

    <div class="example" role="group" aria-labelledby="example-heading">
      <h2 id="example-heading" class="visually-hidden">Example results</h2>
      <div class="example-card wide">
        <div class="example-head"><span class="example-icon"><Icon name="scale" size={22} /></span><span class="example-title">Body Mass Index</span><span class="example-tag">Illustrative</span></div>
        <p class="example-value">{bmi.display} <small>kg/m²</small></p>
        <p class="example-note">{bmi.category.label} (CDC category)</p>
      </div>
      <div class="example-card">
        <div class="example-head"><span class="example-icon"><Icon name="flame" size={22} /></span><span class="example-title">Energy</span><span class="example-tag">Illustrative</span></div>
        <dl class="example-list">
          <div><dt>Resting (REE)</dt><dd>{energy.reeDisplay} kcal</dd></div>
          <div><dt>Total (TEE)</dt><dd>{energy.teeDisplay} kcal</dd></div>
        </dl>
      </div>
      <div class="example-card">
        <div class="example-head"><span class="example-icon"><Icon name="person" size={22} /></span><span class="example-title">Composition</span><span class="example-tag">Illustrative</span></div>
        <div class="example-ring">
          <ResultRing fill={fat.percent} label={`Example estimated body fat: ${fat.percentDisplay} percent`} size={72} />
          <p class="example-value small">{fat.percentDisplay}<small>%</small></p>
        </div>
        <p class="example-note">Estimated body fat</p>
      </div>
      <p class="example-caption">Sample demonstration values for one stated example (man, 28 years, 178 cm, 74 kg, neck 38 cm, waist 84 cm, Low Active). Not real results and not personal health data.</p>
    </div>
  </section>

  <section class="strip" aria-labelledby="sources-heading">
    <div>
      <h2 id="sources-heading" class="strip-title">Sources and Methods</h2>
      <ul class="strip-list">
        {sources.map((s) => (
          <li><a href={s.href} rel="noopener noreferrer">{s.label}<Icon name="external-link" size={14} /></a></li>
        ))}
      </ul>
    </div>
    <p class="strip-note">Educational resource. Not affiliated with or endorsed by these organizations.</p>
  </section>

  <section class="section" id="calculators" aria-labelledby="calculators-heading">
    <div class="section-head">
      <div>
        <span class="section-kicker">Health calculators</span>
        <h2 id="calculators-heading">Explore Our Health Calculators</h2>
        <p>Simple tools. Clear results. Better understanding.</p>
      </div>
    </div>
    <div class="card-grid">
      {calculators.map((calculator) => <CalculatorCard calculator={calculator} />)}
    </div>
  </section>

  {latest.length > 0 && (
    <section class="section" aria-labelledby="journal-heading">
      <div class="section-head">
        <div>
          <span class="section-kicker">Evidence-Based Editorial</span>
          <h2 id="journal-heading">Explore Our Health Journal</h2>
          <p>Evidence-informed articles that explain the numbers behind our calculators, with their sources.</p>
        </div>
        <a class="text-link" href="/journal/">View All Articles <Icon name="arrow-right" size={18} /></a>
      </div>
      <div class="card-grid">
        {latest.map((article) => <ArticleCard article={article} level={3} />)}
      </div>
    </section>
  )}
</BaseLayout>
<style>
  .hero { display: grid; gap: var(--space-xl); align-items: center; padding-block: var(--space-md) var(--space-lg); }
  .hero-copy { display: grid; gap: var(--space-md); justify-items: start; }
  .hero-copy h1 { margin: 0; font-size: var(--fs-display); line-height: 1.1; }
  .hero-accent { color: var(--color-primary); }
  .hero-copy p { margin: 0; max-width: 34rem; font-size: var(--fs-body-xl); color: var(--color-on-surface-variant); }
  .kicker { display: inline-block; padding: 0.25rem 0.75rem; border-radius: var(--radius-full); background: var(--color-secondary-container); color: var(--color-on-secondary-container); font-size: var(--fs-label-sm); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .reassure { display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-md); margin: 0; padding: 0; list-style: none; font-size: var(--fs-small); font-weight: 500; }
  .reassure li { display: inline-flex; align-items: center; gap: 0.35rem; }
  .reassure :global(svg) { color: var(--color-secondary); }

  .example { display: grid; gap: var(--space-sm); padding: var(--space-md); border-radius: var(--radius-lg); background: radial-gradient(circle at 15% 10%, var(--color-primary-fixed) 0, transparent 60%), var(--color-surface-low); }
  @media (min-width: 40rem) { .example { grid-template-columns: repeat(2, minmax(0, 1fr)); } .example-card.wide, .example-caption { grid-column: 1 / -1; } }
  .example-card { padding: var(--space-md); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); box-shadow: var(--shadow-panel); }
  .example-head { display: flex; align-items: center; gap: var(--space-sm); margin-block-end: var(--space-sm); }
  .example-icon { flex: none; display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: var(--radius-md); background: var(--color-secondary-container); color: var(--color-on-secondary-container); }
  .example-title { flex: 1; font-weight: 600; }
  .example-tag { padding: 0.125rem 0.5rem; border-radius: var(--radius-full); background: var(--color-surface-low); color: var(--color-secondary); font-size: var(--fs-label-sm); font-weight: 700; }
  .example-value { margin: 0; font-family: var(--font-heading); font-size: var(--fs-metric); font-weight: 800; line-height: 1.1; color: var(--color-primary); }
  .example-value small { font-size: var(--fs-body); font-weight: 600; color: var(--color-on-surface-variant); }
  .example-value.small { font-size: var(--fs-h2); }
  .example-note { margin: var(--space-xs) 0 0; font-size: var(--fs-small); color: var(--color-on-surface-variant); }
  .example-list { display: grid; gap: var(--space-xs); margin: 0; }
  .example-list div { display: flex; justify-content: space-between; gap: var(--space-sm); padding: 0.4rem 0.75rem; border-radius: var(--radius-md); background: var(--color-surface-low); font-size: var(--fs-small); }
  .example-list dt { color: var(--color-on-surface-variant); }
  .example-list dd { margin: 0; font-weight: 700; font-variant-numeric: tabular-nums; }
  .example-ring { display: flex; align-items: center; gap: var(--space-md); }
  .example-caption { margin: 0; padding: var(--space-xs) var(--space-sm); font-size: var(--fs-label-sm); text-align: center; color: var(--color-on-surface-variant); }

  .strip { display: grid; gap: var(--space-sm); margin-block-start: var(--space-lg); padding: var(--space-md); border-radius: var(--radius-lg); background: var(--color-surface-low); }
  .strip-title { margin: 0 0 var(--space-xs); font-family: var(--font-body); font-size: var(--fs-label-sm); letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-on-surface-variant); }
  .strip-list { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin: 0; padding: 0; list-style: none; }
  .strip-list a { display: inline-flex; align-items: center; gap: 0.35rem; min-height: var(--touch); padding: 0 var(--space-sm); border-radius: var(--radius-full); background: var(--color-surface); border: 1px solid var(--color-border); font-size: var(--fs-small); font-weight: 600; text-decoration: none; }
  .strip-list a:hover { background: var(--color-secondary-container); }
  .strip-note { margin: 0; font-size: var(--fs-small); color: var(--color-on-surface-variant); }
  @media (min-width: 64rem) {
    .hero { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .strip { grid-template-columns: minmax(0, 1fr) auto; align-items: center; }
    .strip-note { max-width: 18rem; text-align: end; }
  }
</style>
