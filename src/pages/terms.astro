---
// Terms of Use: DRAFT for the owner's review (DESIGN-SPEC.md 11, D-LEGAL). No company name, jurisdiction or governing law is invented.
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalPage from '../components/LegalPage.astro';
import { CONTACT_EMAIL } from '../config/site';

const toc = [
  { id: 'acceptance', label: 'Using this website' },
  { id: 'purpose', label: 'Educational purpose' },
  { id: 'calculators', label: 'The calculators' },
  { id: 'content', label: 'Articles and sources' },
  { id: 'use', label: 'Acceptable use' },
  { id: 'links', label: 'Links to other websites' },
  { id: 'availability', label: 'Availability and accuracy' },
  { id: 'liability', label: 'Limitation of liability' },
  { id: 'changes', label: 'Changes to these terms' },
  { id: 'contact', label: 'Contact' },
];
---
<BaseLayout title="Terms of Use" description="The terms for using BodyMetrics Lab: an educational website with free health calculators and articles, not medical advice.">
  <LegalPage title="Terms of Use" kicker="Legal" intro="The rules for using BodyMetrics Lab, in plain language." toc={toc} updated="25 November 2026">
    <h2 id="acceptance">Using this website</h2>
    <p>By using BodyMetrics Lab you agree to these terms. If you do not agree, please do not use the website.</p>

    <h2 id="purpose">Educational purpose</h2>
    <p>BodyMetrics Lab is a free educational resource. Everything on it, including the calculators, results and articles, is provided for general information and education only. It is not medical advice, diagnosis or treatment, and it does not create a relationship between you and any healthcare professional. See our <a href="/medical-disclaimer/">Medical Disclaimer</a>.</p>

    <h2 id="calculators">The calculators</h2>
    <p>The calculators give estimates based on published equations and the numbers you enter. Each calculator page shows its formula and sources. Results are estimates, may not suit your individual situation and should not be used to make medical decisions or to set a calorie target, diet or treatment. Input limits and age ranges on the calculators are technical and website rules, not medical thresholds.</p>

    <h2 id="content">Articles and sources</h2>
    <p>Articles are written for general education and list the sources they use. We aim to be accurate and to say when a source is secondary, but science and guidance change, so please check important information with the original sources and with a qualified professional.</p>

    <h2 id="use">Acceptable use</h2>
    <p>You may use the website for your own personal, non-commercial purposes. Please do not attempt to disrupt or overload the website, to access it in ways it is not intended, or to present its content as your own.</p>

    <h2 id="links">Links to other websites</h2>
    <p>The website links to other websites, such as the organisations whose publications we cite. We do not control those websites and are not responsible for their content. BodyMetrics Lab is not affiliated with or endorsed by CDC, WHO, NIH, the National Academies, the US Navy or any other organisation we cite.</p>

    <h2 id="availability">Availability and accuracy</h2>
    <p>The website and its content are provided "as is" and "as available". We do not promise that the website will always be available, uninterrupted or free of errors, or that any result or information is complete or suitable for your needs.</p>

    <h2 id="liability">Limitation of liability</h2>
    <p>To the extent permitted by law, BodyMetrics Lab is not liable for any loss or harm that results from using the website or relying on its calculators, results or articles. Nothing in these terms limits any right or liability that cannot be limited by law.</p>

    <h2 id="changes">Changes to these terms</h2>
    <p>We may update these terms as the website changes. The date at the top of the page shows when they were last updated, and continued use of the website means you accept the updated terms.</p>

    <h2 id="contact">Contact</h2>
    <p>Questions about these terms can be sent to <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</p>
  </LegalPage>
</BaseLayout>
