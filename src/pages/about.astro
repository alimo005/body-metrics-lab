---
// About Us (DESIGN-SPEC.md 11 and 20.1): exactly five sections, the owner-approved statement verbatim, three role cards and the
// editorial process as a policy going forward. No names, qualifications, licences or credentials; no "independent".
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import '../styles/pages.css';

const roles = [
  { icon: 'code', title: 'Software Development Team', text: 'Builds, maintains and improves the website, its calculators and their technical functionality.' },
  { icon: 'document', title: 'Health Content Writers', text: 'Research, prepare and write educational health articles and reports using reliable scientific references.' },
  { icon: 'checklist', title: 'Specialist Content Reviewer', text: 'Reviews articles and reports, checking clarity, consistency, source quality and the accurate presentation of scientific information.' },
] as const;

const steps = [
  { title: 'Research', text: 'Our writers gather reliable scientific references for each topic.' },
  { title: 'Prepare and write', text: 'They prepare the article or report from those references and list the sources used.' },
  { title: 'Review', text: 'The specialist content reviewer checks clarity, consistency, source quality and the accurate presentation of the science.' },
  { title: 'Publish', text: 'The article is published with its sources and its publication date.' },
] as const;
---
<BaseLayout title="About Us" description="BodyMetrics Lab is a free educational health website with three calculators and a Health Journal that explains the science behind them.">
  <PageHero
    breadcrumb={[{ label: 'Home', href: '/' }, { label: 'About Us' }]}
    kicker="About us"
    title="About BodyMetrics Lab"
    intro="Free health calculators and educational articles that explain your numbers clearly."
  />

  <div class="about">
    <section class="card about-card" aria-labelledby="who-heading">
      <h2 id="who-heading">Who We Are</h2>
      <p>BodyMetrics Lab is a free educational health website. It offers three calculators (BMI, BMR &amp; TDEE, and body fat) and a Health Journal of articles that explain the science behind them. The calculators run in your browser, so the numbers you enter are not stored or sent anywhere. BodyMetrics Lab is not affiliated with or endorsed by CDC, WHO, NIH, the National Academies, the US Navy or any other organisation.</p>
    </section>

    <section class="card about-card" aria-labelledby="mission-heading">
      <h2 id="mission-heading">Our Mission</h2>
      <p>To help people understand their health numbers through clear explanations, transparent methods and reliable sources.</p>
    </section>

    <section class="card about-card" aria-labelledby="team-heading">
      <h2 id="team-heading">Our Team</h2>
      <p>BodyMetrics Lab is built by one coordinated team with three roles.</p>
      <blockquote class="statement">
        <p>"The BodyMetrics Lab platform and its educational reports are developed, written, and reviewed by specialists from the BodyMetrics Lab team, with a focus on scientific accuracy, transparent methodologies, and clear, practical health information."</p>
      </blockquote>
      <ul class="roles">
        {roles.map((role) => (
          <li class="role">
            <span class="role-icon"><Icon name={role.icon} size={26} /></span>
            <h3>{role.title}</h3>
            <p>{role.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="card about-card" aria-labelledby="process-heading">
      <h2 id="process-heading">Our Editorial Process</h2>
      <p>This is the BodyMetrics Lab editorial policy going forward: every new educational article and report follows the same four stages before it is published.</p>
      <ol class="steps">
        {steps.map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="card about-card" aria-labelledby="commitment-heading">
      <h2 id="commitment-heading">Our Commitment to Accuracy and Transparency</h2>
      <ul class="points">
        <li>Each calculator page shows its formula and its sources, and says when a source is secondary.</li>
        <li>Our calculators provide educational estimates. They are not a substitute for professional medical advice.</li>
        <li>Every health article ends with a Sources section that links to the references used.</li>
      </ul>
      <p class="contact-line">Questions? <a href="/contact/">Contact us</a>.</p>
    </section>
  </div>
</BaseLayout>
<style>
  .about { display: grid; gap: var(--space-md); max-width: 64rem; }
  .about-card { padding: var(--space-md); }
  @media (min-width: 48rem) { .about-card { padding: var(--space-lg); } }
  .about-card h2 { margin-block-end: var(--space-sm); }
  .about-card p { max-width: 46rem; margin: 0 0 var(--space-md); color: var(--color-on-surface-variant); }
  .about-card p:last-child { margin-block-end: 0; }
  .statement { max-width: 46rem; margin: var(--space-md) 0; padding: var(--space-md); border-inline-start: 4px solid var(--color-secondary); border-radius: var(--radius-md); background: var(--color-surface-low); }
  .statement p { margin: 0; color: var(--color-on-surface); font-size: var(--fs-body-lg); }

  .roles { position: relative; display: grid; gap: var(--space-md); margin: 0; padding: 0; list-style: none; }
  .role { padding: var(--space-md); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface-low); }
  .role-icon { display: grid; place-items: center; width: 3rem; height: 3rem; margin-block-end: var(--space-sm); border-radius: var(--radius-md); background: var(--color-secondary-container); color: var(--color-on-secondary-container); }
  .role h3 { margin: 0 0 var(--space-xs); }
  .role p { margin: 0; font-size: var(--fs-small); }
  /* subtle connector joining the three roles (one team, no hierarchy) */
  .roles::before { content: ''; position: absolute; inset-block: 1.5rem; inset-inline-start: 1.5rem; width: 2px; background: var(--color-outline-variant); }
  .role { position: relative; z-index: 1; margin-inline-start: 0; }
  @media (min-width: 64rem) {
    .roles { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .roles::before { inset-block: 1.5rem auto; inset-inline: 3rem; width: auto; height: 2px; }
  }

  .steps { display: grid; gap: var(--space-md); margin: 0; padding: 0; list-style: none; counter-reset: step; }
  .steps li { position: relative; padding: var(--space-md) var(--space-md) var(--space-md) 4rem; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface-low); counter-increment: step; }
  .steps li::before { content: counter(step); position: absolute; inset-block-start: var(--space-md); inset-inline-start: var(--space-md); display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: var(--radius-full); background: var(--color-primary); color: var(--color-on-primary); font-family: var(--font-heading); font-weight: 700; }
  .steps h3 { margin: 0 0 var(--space-xs); }
  .steps p { margin: 0; font-size: var(--fs-small); }
  @media (min-width: 64rem) { .steps { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

  .points { display: grid; gap: var(--space-sm); max-width: 46rem; margin: 0 0 var(--space-md); padding-inline-start: 1.25rem; color: var(--color-on-surface-variant); }
  .contact-line { color: var(--color-on-surface); }
</style>
