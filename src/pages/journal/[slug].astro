---
// Reusable article template (DESIGN-SPEC.md 9.2): every published Markdown file in src/content/journal/ gets /journal/<slug>/
// with the same layout. Nothing here is specific to one article.
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ArticleMedia from '../../components/ArticleMedia.astro';
import Icon from '../../components/Icon.astro';
import Notice from '../../components/Notice.astro';
import { calculators } from '../../config/site';
import { formatDate, getArticlesForRoutes, hasUpdate, isPreviewOnly, problemsOf, readMinutes } from '../../lib/journal';
import '../../styles/pages.css';

// Production: one page per PUBLISHED article. Local dev server only: drafts and future-dated articles also get a page (a preview).
export async function getStaticPaths() {
  const articles = await getArticlesForRoutes();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const preview = isPreviewOnly(article);
const problems = preview ? problemsOf(article) : [];
const { Content } = await render(article);
const { title, description, pubDate, updatedDate, relatedCalculator } = article.data;
const calculator = calculators.find((c) => c.slug === relatedCalculator);
const iso = (d: Date) => d.toISOString().slice(0, 10);
---
<BaseLayout title={title} description={description}>
  {preview && (
    <div class="preview-banner" role="note">
      <p><strong>Draft preview.</strong> This article is not published: it is visible only on your local development server, and it is not in the Journal list, on the home page, in the sitemap or in the built website. Set <code>draft: false</code> to publish it.</p>
      {problems.length > 0 ? (
        <div class="preview-problems"><strong>To fix before publishing:</strong><ul>{problems.map((problem) => <li>{problem}</li>)}</ul></div>
      ) : (
        <p class="preview-ok">No problems found: this article passes every publishing rule.</p>
      )}
    </div>
  )}
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Health Journal', href: '/journal/' }, { label: title }]} />
  <header class="article-head">
    <h1>{title}</h1>
    <p class="article-byline">
      <span><Icon name="document" size={16} /> BodyMetrics Lab Editorial Team</span>
      <span><Icon name="calendar" size={16} /> Published <time datetime={iso(pubDate)}>{formatDate(pubDate)}</time></span>
      {hasUpdate(article) && updatedDate && <span>Updated <time datetime={iso(updatedDate)}>{formatDate(updatedDate)}</time></span>}
      <span><Icon name="clock" size={16} /> {readMinutes(article)} min read</span>
    </p>
  </header>
  <div class="article-hero">
    <ArticleMedia article={article} width={1000} eager />
  </div>
  <article class="prose">
    <Content />
  </article>
  <div class="article-end">
    {calculator && (
      <section class="card guide-banner" style="margin-block: 0" aria-labelledby="calc-callout-heading">
        <div>
          <p class="section-kicker">Related calculator</p>
          <h2 id="calc-callout-heading">{calculator.label}</h2>
          <p>{calculator.description}</p>
        </div>
        <a class="button primary" href={calculator.href}>
          <span>{calculator.cta}</span>
          <Icon name="arrow-right" size={18} />
        </a>
      </section>
    )}
    <Notice icon="info">
      <p><strong>Educational information only.</strong> This article is not medical advice, diagnosis or treatment. For personal health questions, speak with a qualified healthcare professional.</p>
    </Notice>
    <a class="text-link" href="/journal/"><Icon name="arrow-right" size={18} class="flip-icon" /> Back to Health Journal</a>
  </div>
</BaseLayout>
<style>
  :global(.flip-icon) { transform: scaleX(-1); }
  .preview-banner { margin: 0 0 var(--space-md); padding: var(--space-sm) var(--space-md); border: 2px dashed var(--color-outline); border-radius: var(--radius-md); background: var(--color-surface); font-size: var(--fs-small); }
  .preview-problems { display: block; margin-top: var(--space-xs); }
  .preview-problems ul { margin: var(--space-xs) 0 0; padding-inline-start: 1.25rem; }
  .preview-banner code { padding: 0.1rem 0.35rem; border-radius: var(--radius-sm); background: var(--color-surface-mid); }
</style>
