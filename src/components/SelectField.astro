---
// Labelled native select with a placeholder, an optional description slot and an inline error slot (DESIGN-SPEC.md 7, 10.3).
// No option is preselected: the disabled placeholder is shown until the person chooses.
import Icon from './Icon.astro';

interface Option {
  value: string;
  label: string;
}
interface Props {
  id: string;
  label: string;
  placeholder: string;
  options: Option[];
  /** Id of the element (in the slot) that describes the current choice. */
  descriptionId?: string;
}
const { id, label, placeholder, options, descriptionId } = Astro.props;
const errorId = `${id}-error`;
---
<div class="field" data-field={id}>
  <label class="field-label" for={id}>{label}</label>
  <div class="select-control">
    <select id={id} name={id} aria-describedby={descriptionId ? `${descriptionId} ${errorId}` : errorId}>
      <option value="" selected disabled>{placeholder}</option>
      {options.map((option) => <option value={option.value}>{option.label}</option>)}
    </select>
    <Icon name="chevron-down" size={20} class="select-icon" />
  </div>
  <slot />
  <p class="field-error" id={errorId} role="alert" hidden></p>
</div>
<style>
  .field { min-width: 0; }
  .select-control {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 3rem;
    border: 1.5px solid var(--color-outline);
    border-radius: var(--radius-md);
    background: var(--color-surface-low);
  }
  .select-control:focus-within {
    border-color: var(--color-focus);
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }
  select {
    flex: 1;
    min-width: 0;
    height: 100%;
    min-height: calc(3rem - 3px);
    padding: 0 2.5rem 0 var(--space-md);
    border: 0;
    background: transparent;
    font-size: var(--fs-body-lg);
    appearance: none;
    outline: none;
    cursor: pointer;
    text-overflow: ellipsis;
  }
  select:has(option[value='']:checked) { color: var(--color-on-surface-variant); }
  select option { color: var(--color-on-surface); background: var(--color-surface); }
  .select-control :global(.select-icon) {
    position: absolute;
    inset-inline-end: var(--space-sm);
    pointer-events: none;
    color: var(--color-on-surface-variant);
  }
  .field:has(select[aria-invalid='true']) .select-control {
    border-color: var(--color-error);
    background: var(--color-error-container);
  }
  .field-error { margin: var(--space-xs) 0 0; font-size: var(--fs-small); font-weight: 500; color: var(--color-error); }
</style>
