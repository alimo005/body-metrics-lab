---
// Pill-style choice built on real radio buttons (arrow keys move between options natively).
interface Option {
  value: string;
  label: string;
  checked?: boolean;
}
interface Props {
  name: string;
  legend: string;
  options: Option[];
  /** Short helper text shown beside the legend. */
  note?: string;
  noteId?: string;
}
const { name, legend, options, note, noteId } = Astro.props;
---
<fieldset class="segmented" aria-describedby={note ? noteId : undefined}>
  <legend>
    <span class="field-label">{legend}</span>
    {note && <span class="field-note" id={noteId} aria-hidden="true">{note}</span>}
  </legend>
  <div class="segmented-options">
    {options.map((option) => (
      <label>
        <input type="radio" name={name} value={option.value} checked={option.checked} />
        <span>{option.label}</span>
      </label>
    ))}
  </div>
</fieldset>
<style>
  .segmented { border: 0; margin: 0; padding: 0; min-width: 0; }
  .segmented legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 var(--space-sm);
    width: 100%;
    padding: 0;
    margin-block-end: var(--space-xs);
  }
  .segmented-options {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: var(--space-xs);
    padding: 0.25rem;
    border-radius: var(--radius-lg);
    background: var(--color-surface-mid);
    border: 1.5px solid var(--color-outline); /* control boundary, 3:1 against the panel */
  }
  .segmented label { position: relative; display: block; }
  .segmented input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .segmented label span {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-md);
    font-size: var(--fs-small);
    font-weight: 500;
    text-align: center;
    color: var(--color-on-surface-variant);
    transition: background-color var(--ease), color var(--ease);
  }
  .segmented input:checked + span {
    background: var(--color-surface);
    color: var(--color-primary);
    font-weight: 700;
    box-shadow: var(--shadow-chip), inset 0 0 0 2px var(--color-primary); /* selected state outline, not colour alone */
  }
  .segmented input:focus-visible + span {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }
</style>
