---
// Medical-review attribution (DESIGN-SPEC.md 11.1). Renders NOTHING unless it is given an attribution, and an attribution exists only
// when the page's metadata confirms a review (src/lib/review.ts). Kept apart from the editorial byline: authorship and medical review
// are different things. Reusable for further reviewers and, later, for a calculator that has actually been reviewed and approved.
import Icon from './Icon.astro';
import { formatDate } from '../lib/journal';
import type { ReviewAttribution } from '../lib/review';

interface Props {
  attribution: ReviewAttribution | null;
}
const { attribution } = Astro.props;
---
{attribution && (
  <aside class="review" aria-label="Medical review">
    <p class="review-by"><Icon name="check" size={18} /> Medically reviewed by <strong>{attribution.name}</strong></p>
    <p class="review-role">{attribution.role} · {attribution.title}</p>
    <p class="review-meta">
      <span>Last reviewed: <time datetime={attribution.dateIso}>{formatDate(new Date(attribution.dateIso))}</time></span>
      <a class="review-link" href={attribution.profileUrl} target="_blank" rel="noopener noreferrer">View Professional Profile<span class="visually-hidden"> (opens in a new tab)</span></a>
    </p>
  </aside>
)}
<style>
  .review { margin-block: var(--space-md); padding: var(--space-sm) var(--space-md); border: 1px solid var(--color-border); border-inline-start: 4px solid var(--color-secondary); border-radius: var(--radius-md); background: var(--color-surface-low); font-size: var(--fs-small); }
  .review p { margin: 0; }
  .review-by { display: flex; align-items: center; gap: var(--space-xs); color: var(--color-on-surface); }
  .review-role { margin-block-start: 2px; color: var(--color-on-surface-variant); }
  .review-meta { display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-md); margin-block-start: var(--space-xs); color: var(--color-on-surface-variant); }
  .review-link { display: inline-flex; align-items: center; min-height: 2.75rem; color: var(--color-primary); text-decoration: underline; text-underline-offset: 0.2em; }
</style>
