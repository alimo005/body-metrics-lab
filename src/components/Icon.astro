---
// Reusable inline SVG icons (DESIGN-SPEC.md 12.1): no icon font, no icon library.
// Simple 24x24 stroke icons drawn for this site. Decorative by default (aria-hidden);
// pass `label` when an icon stands alone and needs an accessible name.

const icons = {
  menu: '<path d="M4 6.5h16M4 12h16M4 17.5h16"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  'chevron-down': '<path d="M6 9l6 6 6-6"/>',
  'chevron-up': '<path d="M6 15l6-6 6 6"/>',
  home: '<path d="M3.5 11 12 4l8.5 7"/><path d="M5.5 9.5V20h13V9.5"/><path d="M10 20v-5.5h4V20"/>',
  calculator:
    '<rect x="5" y="3" width="14" height="18" rx="2.5"/><path d="M8.5 7.5h7"/><path d="M8.5 12h.01M12 12h.01M15.5 12h.01M8.5 15.5h.01M12 15.5h.01M15.5 15.5h.01"/>',
  book: '<path d="M12 6.5C10.4 5.2 8 4.6 4.5 4.6v12.8c3.5 0 5.9.6 7.5 1.9 1.6-1.3 4-1.9 7.5-1.9V4.6c-3.5 0-5.9.6-7.5 1.9z"/><path d="M12 6.5v12.8"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5.2M12 8h.01"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3.5 7.5 12 13l8.5-5.5"/>',
  lock: '<rect x="5" y="11" width="14" height="9" rx="2.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"/>',
  moon: '<path d="M20.5 13.2A8.5 8.5 0 1 1 10.8 3.5a6.8 6.8 0 0 0 9.7 9.7z"/>',
  'arrow-right': '<path d="M5 12h14M13 6l6 6-6 6"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  'external-link': '<path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>',
  'rotate-ccw': '<path d="M3.5 12a8.5 8.5 0 1 0 2.6-6.1L3.5 8.5M3.5 3.5v5h5"/>',
  sigma: '<path d="M18 5H6l6.5 7L6 19h12"/>',
  scale: '<rect x="3.5" y="4" width="17" height="16" rx="3"/><path d="M8 10.5a4.5 4.5 0 0 1 8 0H8zM12 10.5l2-2.5"/>',
  flame: '<path d="M12 3c.8 3 4.5 4.8 4.5 9a4.5 4.5 0 0 1-9 0c0-2 1-3.2 2-4.2.3 1.2.9 1.8 1.6 2C11.2 7.6 11.4 5.2 12 3z"/>',
  person: '<circle cx="12" cy="5" r="2.2"/><path d="M5.5 9.5 12 8l6.5 1.5M12 8v6.5M9.5 21l2.5-6.5 2.5 6.5"/>',
  code: '<path d="M8.5 7 4 12l4.5 5M15.5 7 20 12l-4.5 5M13.5 5l-3 14"/>',
  document: '<path d="M6 3.5h8l4 4v13H6z"/><path d="M14 3.5v4h4M9 12.5h6M9 16h4"/>',
  checklist: '<path d="M4 6l1.5 1.5L8.5 4.5M4 13l1.5 1.5 3-3M12 6.5h8M12 13h3"/><circle cx="16.5" cy="17" r="3"/><path d="M18.7 19.2 21 21.5"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  calendar: '<rect x="4" y="5" width="16" height="15" rx="2.5"/><path d="M4 10h16M8.5 3v4M15.5 3v4"/>',
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  /** Size in px (width and height). */
  size?: number;
  class?: string;
  /** Accessible name; leave empty for decorative icons. */
  label?: string;
}

const { name, size = 22, class: className, label } = Astro.props;
---
<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={icons[name]}
/>
