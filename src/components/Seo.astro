---
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogImage?: string;
}

import { INDEXING_ENABLED } from '../config/site';

const { title, description, noindex: pageNoindex = false, ogImage } = Astro.props;
// One release switch for the whole site (src/config/site.ts): everything is noindex until the owner enables indexing.
const noindex = !INDEXING_ENABLED || pageNoindex;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = canonical.pathname === '/'
  ? 'BodyMetrics Lab — Free health calculators with clear explanations'
  : `${title} | BodyMetrics Lab`;
const image = ogImage ? new URL(ogImage, canonical) : undefined;
---
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#dff9f0" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0b1b16" media="(prefers-color-scheme: dark)" />
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="BodyMetrics Lab" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
{image && <meta property="og:image" content={image.href} />}
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{image && <meta name="twitter:image" content={image.href} />}
