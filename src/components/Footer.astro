---
import Logo from './Logo.astro';

const groups = [
  { title: 'Explore', links: [['All calculators', '/calculators/'], ['Journal', '/journal/'], ['About', '/about/']] },
  { title: 'The essentials', links: [['Privacy policy', '/privacy/'], ['Terms', '/terms/'], ['Medical disclaimer', '/medical-disclaimer/'], ['Contact', '/contact/']] },
];
---
<footer>
  <div class="container footer-content">
    <div>
      <Logo />
      <p>A little more clarity. A healthier way forward.</p>
    </div>
    {groups.map(({ title, links }) => (
      <nav aria-label={title}>
        <h2>{title}</h2>
        {links.map(([label, href]) => (
          <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
    ))}
    <p class="disclaimer"><strong>KNOWLEDGE, WITH CARE:</strong> These tools provide estimates for education. They do not diagnose conditions or replace personalized medical advice. Speak with a qualified healthcare professional about your results.</p>
  </div>
  <div class="container bottom">
    <span>© {new Date().getFullYear()} BodyMetrics Lab</span>
    <span>Made for every body. Built on evidence.</span>
  </div>
</footer>

<style>
  footer { background: var(--surface-soft); border-top: 1px solid var(--line); color: var(--muted); }
  .footer-content { display: grid; gap: var(--space-4); padding-block: var(--space-6); }
  h2 { color: var(--ink); font-size: var(--text-body); margin: 0; letter-spacing: normal; }
  nav a { display: flex; align-items: center; min-height: var(--touch); width: fit-content; }
  p, .bottom, nav a { font-size: var(--text-small); }
  .disclaimer { margin: 0; }
  .disclaimer strong { display: block; color: var(--accent); margin-bottom: var(--space-2); }
  .bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2); border-top: 1px solid var(--line); padding-block: var(--space-4); }
  @media (min-width: 36rem) { .footer-content { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 58rem) { .footer-content { grid-template-columns: 1.1fr 0.8fr 0.8fr 1.3fr; } }
</style>
